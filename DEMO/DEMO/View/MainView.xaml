<Window
    x:Class="DEMO.View.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DEMO.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Chat - AI FAKE"
    Width="1100"
    Height="720"
    Background="#0E0F12"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  ======= COLOR PALETTE =======  -->
        <SolidColorBrush x:Key="Bg" Color="#0E0F12" />
        <SolidColorBrush x:Key="Panel" Color="#121317" />
        <SolidColorBrush x:Key="PanelSoft" Color="#16181D" />
        <SolidColorBrush x:Key="Line" Color="#23262E" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E9EAEE" />
        <SolidColorBrush x:Key="TextSecondary" Color="#B3B7C0" />
        <SolidColorBrush x:Key="BubbleAI" Color="#1E2026" />
        <SolidColorBrush x:Key="BubbleUser" Color="#3A86FF" />
        <SolidColorBrush x:Key="InputBg" Color="#0F1115" />

        <CornerRadius x:Key="Radius2xl">16</CornerRadius>

        <!--  ======= BUTTON STYLE =======  -->
        <Style x:Key="TopIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A1C22" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  ListBoxItem style  -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!--  ======= MESSAGE TEMPLATE =======  -->
        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Host container  -->
                <StackPanel
                    x:Name="Host"
                    Grid.Column="0"
                    Margin="10"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <!--  Avatar  -->
                    <Border
                        x:Name="Avatar"
                        Width="28"
                        Height="28"
                        VerticalAlignment="Top"
                        Background="#20232A"
                        CornerRadius="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="🤖" />
                    </Border>

                    <!--  Message bubble  -->
                    <Border
                        x:Name="Bubble"
                        Padding="12"
                        Background="{StaticResource BubbleAI}"
                        CornerRadius="{StaticResource Radius2xl}">
                        <StackPanel Margin="4">
                            <TextBlock
                                FontSize="15"
                                Foreground="{StaticResource TextPrimary}"
                                Text="{Binding Text}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondary}"
                                Text="{Binding Time, StringFormat={}{0:HH\\:mm}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!--  Trigger để đổi style nếu là User  -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Host" Property="Grid.Column" Value="1" />
                    <Setter TargetName="Host" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource BubbleUser}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  ======= TEXTBOX PLACEHOLDER =======  -->
        <Style x:Key="WatermarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" />
                            <TextBlock
                                x:Name="Watermark"
                                Margin="12,12,12,0"
                                Foreground="{StaticResource TextSecondary}"
                                IsHitTestVisible="False"
                                Text="Nhập tin nhắn của bạn..."
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ======= PILL BUTTON =======  -->
        <Style
            x:Key="PillButton"
            BasedOn="{StaticResource TopIconButton}"
            TargetType="Button">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#1A1C22" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter Property="Background" Value="#23262E" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--  =================== MAIN LAYOUT ===================  -->
    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <!--  Header  -->
            <RowDefinition />
            <!--  Messages  -->
            <RowDefinition Height="Auto" />
            <!--  Composer  -->
            <RowDefinition Height="20" />
            <!--  Spacer  -->
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="0,0,0,1">
            <Grid Margin="12,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Margin="10"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        Text="New chat" />
                    <Border
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="#23262E"
                        CornerRadius="10">
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondary}"
                            Text="deepseek-r1" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Messages list  -->
        <Border Grid.Row="1" Background="{StaticResource PanelSoft}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox
                    x:Name="MessageList"
                    Padding="16"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource MessageTemplate}"
                    ItemsSource="{Binding Messages, NotifyOnTargetUpdated=True}"
                    TargetUpdated="MessageList_TargetUpdated" />
            </ScrollViewer>
        </Border>

        <!--  Composer  -->
        <Grid Grid.Row="2" Margin="16,14,16,0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Padding="12"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius2xl}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="Composer"
                        MinHeight="48"
                        MaxHeight="160"
                        Focusable="True"
                        KeyDown="Composer_KeyDown"
                        Style="{StaticResource WatermarkTextBox}"
                        Text="{Binding CurrentMessage, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding SendMessageCommand}"
                            Content="➤ Send"
                            Style="{StaticResource PillButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock
                Grid.Row="1"
                Margin="8,6,8,0"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource TextSecondary}"
                Text="Chat AI FAKE (deepseek-r1) có thể mắc lỗi. Hãy kiểm tra thông tin quan trọng." />
        </Grid>
    </Grid>



</Window>
